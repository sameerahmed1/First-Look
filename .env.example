# ===========================================
# FIRST LOOK - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ===========================================
# App Configuration
# ===========================================
# Your app's public URL (used for generating upload links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Google AI (Gemini) Configuration
# ===========================================
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ===========================================
# Supabase Configuration
# ===========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
#
# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous/Public Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (SECRET - NEVER expose in browser, server-side only)
# Used for operations that need to bypass RLS (e.g., customer wizard submissions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# Database Setup Instructions
# ===========================================
# 1. Go to your Supabase Dashboard > SQL Editor
# 2. Run the contents of supabase/schema.sql to create tables
# 3. This will create: contractors, projects, project_media,
#    project_analysis, and upload_links tables

# ===========================================
# Supabase Storage Setup Instructions
# ===========================================
# 1. Go to your Supabase Dashboard > Storage
# 2. Create a new bucket called "media"
# 3. Go to Policies tab and add:
#    - Policy name: "Allow public uploads"
#      Operation: INSERT, Target: anon, WITH CHECK: true
#    - Policy name: "Allow public reads"
#      Operation: SELECT, Target: anon, USING: true

# ===========================================
# Supabase Auth Setup Instructions
# ===========================================
# 1. Go to Authentication > Providers
# 2. Ensure Email provider is enabled
# 3. (Optional) Disable email confirmation for easier testing
